{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowKey",
  "version": "1.0.7",
  "identifier": "com.flowkey.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlowKey",
        "width": 1100,
        "height": 750,
        "minWidth": 850,
        "minHeight": 550,
        "center": true,
        "resizable": true,
        "decorations": false
      },
      {
        "label": "overlay",
        "title": "FlowKey - Now Playing",
        "url": "index.html?window=overlay",
        "width": 640,
        "height": 400,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "search",
        "title": "FlowKey - Search",
        "url": "index.html?window=search",
        "width": 640,
        "height": 400,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "toast",
        "title": "FlowKey - Track Toast",
        "url": "index.html?window=toast",
        "width": 360,
        "height": 96,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "playlist_picker",
        "title": "FlowKey - Add to Playlist",
        "url": "index.html?window=playlist_picker",
        "width": 320,
        "height": 380,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyRTA5QjgwMzI3NDczMjQKUldRa2MzUXlnSnZnc2xrQXFQeTljb3NFY2VhbEI2SU85SWxrTmpOL21UejhJQU9HbkhnUnNSVmcK",
      "endpoints": [
        "https://github.com/GabrielSantos23/flowkey/releases/latest/download/latest.json"
      ]
    }
  }
}
